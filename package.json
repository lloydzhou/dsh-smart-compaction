{
  "name": "dsh-smart-compaction",
  "version": "0.2.1-rc.1",
  "description": "Cache-first compaction with optional adaptive economics for DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lloydzhou/dsh-smart-compaction.git"
  },
  "homepage": "https://github.com/lloydzhou/dsh-smart-compaction#readme",
  "bugs": {
    "url": "https://github.com/lloydzhou/dsh-smart-compaction/issues"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./preset": {
      "types": "./lib/preset.d.ts",
      "import": "./lib/preset.js"
    },
    "./policy": {
      "types": "./lib/policy.d.ts",
      "import": "./lib/policy.js"
    },
    "./package.json": "./package.json",
    "./client": "./client/dist/client.js",
    "./economics": {
      "types": "./lib/adaptive/economics.d.ts",
      "import": "./lib/adaptive/economics.js"
    }
  },
  "files": [
    "lib",
    "README.md",
    "docs",
    "cordis.patch.yml",
    "THIRD_PARTY_NOTICES.md",
    "client/dist"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.1-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit && tsc -p client/tsconfig.json",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-include": "1.0.10",
    "js-yaml": "^4.1.1",
    "@types/js-yaml": "^4.0.9",
    "@deepseek-ai/dsh-agent-loop": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-scope": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-chat": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-session": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.1-rc.3",
    "react": "^19.0.0",
    "@types/react": "^19.0.0",
    "esbuild": "^0.28.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/schemastery": "3.18.5",
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-app-boot": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-agent-preset-registry": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-compaction": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-compaction-basic": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-token-meter": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-session-projection": "^0.2.1-rc.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/schemastery": "3.18.5",
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-app-boot": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-agent-preset-registry": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-compaction": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-compaction-basic": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-token-meter": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-session-projection": "^0.2.1-rc.3"
  }
}
